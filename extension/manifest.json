{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "goooooook Live Vocal Reduction",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://goooooook.kylechan051114.workers.dev/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}